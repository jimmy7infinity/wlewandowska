# Public site origin for SEO (canonical, Open Graph, sitemap, robots). No trailing slash.
# Example: https://www.yourdomain.com
# On Railway: set this in the service Variables tab (build-time), then redeploy after your domain is ready.
VITE_SITE_URL=

# Optional: override default share image (defaults to /og.png in public/, then /pfp.png).
# Example: /og.png
# VITE_OG_IMAGE_PATH=

# Optional: exact pixel size of the share image (for og:image width/height). Defaults match public/og.png.
# VITE_OG_IMAGE_WIDTH=1376
# VITE_OG_IMAGE_HEIGHT=768
